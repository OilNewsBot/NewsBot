# Public build configuration; these values are included in the installed app.
EXPO_PUBLIC_API_URL=https://newsbot.example.com
EXPO_PUBLIC_EAS_PROJECT_ID=
NEWSBOT_IOS_BUNDLE_ID=com.example.newsbot
NEWSBOT_ANDROID_PACKAGE=com.example.newsbot
# Android client configuration file (not the FCM service account key).
GOOGLE_SERVICES_JSON=./google-services.json