# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=

# Model slots. Leave blank to use the defaults in config.jac
# (triage: claude-haiku-4-5, review: claude-opus-5).
TRIAGE_MODEL=
REVIEW_MODEL=

# Telegram (telethon) — from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telegram Bot API fallback — only sees channels the bot administers
TELEGRAM_BOT_TOKEN=

# X: TwitterAPI.io push feed (default X source)
X_PUSH_API_KEY=
# X: official API, pay-per-use polling fallback (also set x_api.enabled in config.yaml)
X_BEARER_TOKEN=
