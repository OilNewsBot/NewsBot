# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=

# Model slots. Leave blank to use the defaults in config.jac
# (triage: claude-haiku-4-5, review: claude-opus-5, trade: claude-haiku-4-5).
TRIAGE_MODEL=
REVIEW_MODEL=
TRADE_MODEL=

# Telegram (telethon) — from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telegram Bot API fallback — only sees channels the bot administers
TELEGRAM_BOT_TOKEN=

# X: TwitterAPI.io push feed (default X source)
X_PUSH_API_KEY=
# X: official API, pay-per-use polling fallback (also set x_api.enabled in config.yaml)
X_BEARER_TOKEN=

# Personal X connections: base64url-encoded random 32-byte encryption key.
# Generate: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep stable across restarts; back it up separately from the database.
# RSS works without it. Never use an API key as this encryption key.
NEWSBOT_CONNECTION_KEY=

# Admin token for operator endpoints, including /portfolio and /ingest.
# Set it on a shared server and send it in X-Admin-Token for admin access.
# Without a configured token, only loopback clients qualify. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEWSBOT_ADMIN_TOKEN=

# Public channels. A hosted demo uses one worker and persistent SQLite storage.
# NEWSSTREAM_HOST=127.0.0.1
# NEWSSTREAM_PORT=8000
# NEWSSTREAM_DB_PATH=data/newsstream.db
# NEWSSTREAM_DEMO_RSS=0 skips scheduled refreshes of the bundled RSS feeds.
# NEWSSTREAM_PUBLIC_RSS=0 disables public RSS networking for offline use.
# NEWSSTREAM_SUMMARY_PROVIDER=disabled turns off paid RSS summaries.
NEWSSTREAM_SUMMARY_MODEL=
# NEWSSTREAM_SUMMARY_DAILY_LIMIT=40
# NEWSSTREAM_SUMMARY_SOURCES=rss
# Add x or community to summarize authorized selections or authored posts.
# For a Chat Completions-compatible endpoint, set all three:
# NEWSSTREAM_SUMMARY_PROVIDER=openai-compatible
# NEWSSTREAM_SUMMARY_BASE_URL=http://127.0.0.1:11434/v1
# NEWSSTREAM_SUMMARY_MODEL=<model served by that endpoint>
# NEWSSTREAM_SUMMARY_API_KEY=<only if required by the server>

# Dedicated Telegram publishing bot. Register its HTTPS webhook with the same
# random secret, as described in docs/getting-started.md.
NEWSSTREAM_TELEGRAM_BOT_USERNAME=
NEWSSTREAM_TELEGRAM_WEBHOOK_SECRET=
